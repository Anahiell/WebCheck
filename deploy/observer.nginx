server {
    listen 127.0.0.1:8080 default_server;
    server_name _;
    server_tokens off;
    root /srv/observer/current;
    autoindex off;
    disable_symlinks on from=$document_root;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    location = / { try_files /index.html =404; }
    location = /index.html { try_files $uri =404; }
    location = /styles.css { try_files $uri =404; }
    location = /app.js { try_files $uri =404; }
    location = /topology.js { try_files $uri =404; }
    location = /api/status {
        alias /var/lib/observer/status.json;
        default_type application/json;
        expires -1;
    }
    location / { return 404; }
}
